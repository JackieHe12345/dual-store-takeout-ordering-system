# Local development defaults. Replace every secret before production deployment.
APP_ENV=production
DEBUG=false
ENABLE_COMMERCE=true
POSTGRES_DB=takeaway
POSTGRES_USER=takeaway
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://takeaway:replace-with-a-long-random-password@postgres:5432/takeaway
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TOKEN_MINUTES=480
ADMIN_DOMAIN=admin.localhost

# Idempotent bootstrap accounts. They are only created by `python -m app.seed`.
SEED_SUPER_ADMIN_PASSWORD=replace-before-first-start
SEED_STORE_A_PASSWORD=replace-before-first-start
SEED_STORE_B_PASSWORD=replace-before-first-start

# Only Nginx is published. PostgreSQL and the backend use the private Docker network.
NGINX_BIND_ADDRESS=0.0.0.0
NGINX_PORT=80
